{
  "fields": {
    "shipment_id": {
      "type": "string",
      "generator": "uuid"
    },
    "order_id": {
      "type": "string",
      "generator": "foreign_key"
    },
    "carrier": {
      "type": "string",
      "generator": "random_choice:顺丰,京东物流,圆通,中通,韵达,申通,邮政"
    },
    "sender_address": {
      "type": "string",
      "generator": "faker_address"
    },
    "receiver_info": {
      "type": "string",
      "generator": "faker_receiver_info"
    },
    "current_status": {
      "type": "string",
      "generator": "random_choice:已揽收,运输中,派送中,已签收,已退回"
    },
    "shipping_time": {
      "type": "timestamp",
      "generator": "current_timestamp"
    },
    "estimated_delivery": {
      "type": "date",
      "generator": "faker_future_date"
    },
    "actual_delivery": {
      "type": "timestamp",
      "generator": "current_timestamp"
    }
  },
  "relationships": {
    "order_id": {
      "table": "oms_order",
      "field": "order_id"
    }
  },
  "post_process": []
}