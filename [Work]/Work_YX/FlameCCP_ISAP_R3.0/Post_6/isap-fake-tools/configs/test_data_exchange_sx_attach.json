{
  "fields": {
    "id": {
      "type": "bigint",
      "generator": "incremental"
    },
    "sxbh": {
      "type": "string",
      "generator": "foreign_key"
    },
    "link": {
      "type": "text",
      "generator": "format:https://oss.example.com/attachments/{date:yyyyMMdd}/{random:12}.{extension}"
    },
    "name": {
      "type": "string",
      "generator": "format:ATTACH_{random:10}.{extension}"
    },
    "original_name": {
      "type": "string",
      "generator": "random_choice:投诉材料.jpg,证据照片.png,身份证明.pdf,合同文件.doc,说明文档.docx,其他材料.zip,视频证据.mp4,音频证据.mp3,扫描文件.pdf,截图文件.jpg"
    },
    "extension": {
      "type": "string",
      "generator": "random_choice:jpg,png,pdf,doc,docx,zip,mp4,mp3,txt,xls,xlsx"
    },
    "attach_size": {
      "type": "bigint",
      "min": 1024,
      "max": 10485760
    },
    "create_time": {
      "type": "timestamp",
      "generator": "current_timestamp"
    },
    "full_path": {
      "type": "text",
      "generator": "format:/data/attachments/{date:yyyy/MM/dd}/{random:12}.{extension}"
    },
    "timestamp": {
      "type": "timestamp",
      "generator": "current_timestamp"
    }
  },
  "relationships": {
    "sxbh": {
      "table": "test_data_exchange_item_info",
      "field": "sxbh"
    }
  },
  "post_process": [
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.jpg'",
      "action": "set_fixed:jpg"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.png'",
      "action": "set_fixed:png"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.pdf'",
      "action": "set_fixed:pdf"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.doc'",
      "action": "set_fixed:doc"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.docx'",
      "action": "set_fixed:docx"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.zip'",
      "action": "set_fixed:zip"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.mp4'",
      "action": "set_fixed:mp4"
    },
    {
      "type": "field_dependency",
      "source_field": "original_name",
      "target_field": "extension",
      "condition": "original_name contains '.mp3'",
      "action": "set_fixed:mp3"
    }
  ]
}
