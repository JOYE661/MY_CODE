{
  "fields": {
    "id": {
      "type": "bigint",
      "generator": "incremental"
    },
    "sxbh": {
      "type": "string",
      "generator": "format:WS{date:yyyyMMdd}{random:6}"
    },
    "sxmd": {
      "type": "string",
      "generator": "random_choice:咨询,建议,申诉,求决"
    },
    "bt": {
      "type": "string",
      "generator": "format:网事项-{name}-{wtsd}问题"
    },
    "created_time": {
      "type": "timestamp",
      "generator": "current_timestamp"
    },
    "fjsl": {
      "type": "smallint",
      "min": 0,
      "max": 5
    },
    "gkbz": {
      "type": "string",
      "generator": "weighted_choice:1:0.9,0:0.1"
    },
    "hyfl": {
      "type": "string",
      "generator": "random_choice:1,2,3,4,5"
    },
    "hyflmc": {
      "type": "string",
      "generator": "random_choice:市场监督,交通,网络防沉迷,货车司机权益保障,企业服务"
    },
    "isbm": {
      "type": "string",
      "generator": "weighted_choice:0:0.9,1:0.1"
    },
    "issq": {
      "type": "string",
      "generator": "weighted_choice:0:0.7,1:0.3"
    },
    "nmbz": {
      "type": "string",
      "generator": "weighted_choice:0:0.8,1:0.2"
    },
    "nrfl": {
      "type": "string",
      "generator": "random_choice:220100,220200,220300,220400,220500,230100,230200,230300,240100,240200,250100,250200,260100,260200"
    },
    "tsnr": {
      "type": "text",
      "generator": "random_text:50,200"
    },
    "update_time": {
      "type": "timestamp",
      "generator": "timestamp_offset:created_time,86400"
    },
    "wtsd": {
      "type": "string",
      "generator": "random_choice:330000000000,330100000000,330200000000,330300000000,330400000000,330500000000,330600000000,330700000000,330800000000,330900000000,331000000000,331100000000"
    },
    "wtsd_addr": {
      "type": "string",
      "generator": "random_choice:浙江省,杭州市,宁波市,温州市,嘉兴市,湖州市,绍兴市,金华市,衢州市,舟山市,台州市,丽水市"
    },
    "sxrq": {
      "type": "timestamp",
      "generator": "current_date"
    },
    "sxrs": {
      "type": "string",
      "generator": "fixed:1"
    },
    "sxxs": {
      "type": "string",
      "generator": "fixed:网"
    },
    "xm": {
      "type": "string",
      "generator": "name"
    },
    "yjly": {
      "type": "string",
      "generator": "random_choice:201,202,203,301"
    },
    "zjhm": {
      "type": "string",
      "generator": "id_card"
    },
    "sjh": {
      "type": "string",
      "generator": "phone"
    },
    "zjlx": {
      "type": "string",
      "generator": "fixed:1"
    },
    "timestamp": {
      "type": "timestamp",
      "generator": "current_timestamp"
    },
    "local_timestamp": {
      "type": "timestamp",
      "generator": "current_timestamp"
    }
  },
  "relationships": {
    "sxbh": {
      "table": "test_data_exchange_sx_attach",
      "field": "sxbh"
    }
  },
  "post_process": [
    {
      "type": "field_dependency",
      "source_field": "yjly",
      "target_field": "sxbh_prefix",
      "condition": "yjly == '201'",
      "action": "set_fixed:ZL"
    },
    {
      "type": "field_dependency",
      "source_field": "yjly",
      "target_field": "sxbh_prefix",
      "condition": "yjly == '202'",
      "action": "set_fixed:ZXB"
    },
    {
      "type": "field_dependency",
      "source_field": "yjly",
      "target_field": "sxbh_prefix",
      "condition": "yjly == '203'",
      "action": "set_fixed:ZWFW"
    },
    {
      "type": "field_dependency",
      "source_field": "yjly",
      "target_field": "sxbh_prefix",
      "condition": "yjly == '301'",
      "action": "set_fixed:SYB"
    }
  ]
}
